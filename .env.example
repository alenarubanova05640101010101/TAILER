# Приложение работает и без этих переменных (кнопки «Google Календарь» и «Apple Календарь» в карточке события
# открывают ссылку / скачивают .ics). Они нужны только для автоматической синхронизации через локальный сервер:
# npm start. Настоящие значения храните в .env (он в .gitignore), токены сервер сохраняет в .data/ (тоже в .gitignore).

PORT=8080

# Google Calendar: console.cloud.google.com → APIs & Services → включить Google Calendar API →
# Credentials → OAuth client ID (тип Web application). Authorized redirect URI: http://localhost:8080/api/google/callback
# На экране согласия добавь свой Google-аккаунт в Test users.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Calendar (iCloud) подключается из интерфейса: Apple ID + пароль приложения
# (appleid.apple.com → Вход и безопасность → Пароли приложений). Переменные не нужны.
